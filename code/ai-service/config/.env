# ===== 服务 =====
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100
AI_SERVICE_LOG_LEVEL=INFO

# ===== LLM Provider（dashscope | ollama | openai）=====
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2

# ===== Embedding Provider（dashscope | ollama | openai）====
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=16

# ===== Reranker（可选；关闭时按混合检索得分排序）=====
RERANKER_ENABLED=false
RERANKER_MODEL=
RERANKER_BASE_URL=http://localhost:8080/v1
RERANKER_API_KEY=
RERANKER_TIMEOUT=30

# ===== PostgreSQL (pgvector) =====
PG_DSN=postgresql://hwc:hwc123456@localhost:5432/hwc_ai
PG_POOL_MIN=2
PG_POOL_MAX=10

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hwc123456

# ===== Redis =====
REDIS_URL=redis://localhost:6379/1
RAG_CACHE_TTL=300

# ===== 检索 =====
RAG_TOP_K=5
RAG_VECTOR_WEIGHT=0.7
RAG_KEYWORD_WEIGHT=0.3