<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hwc</groupId>
        <artifactId>hwc-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>hwc-app-admin</artifactId>
    <name>hwc-app-admin</name>
    <description>管理端启动应用</description>

    <dependencies>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <optional>true</optional>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
            </dependency>
            <dependency>
                <groupId>com.hwc</groupId>
                <artifactId>hwc-security</artifactId>
            </dependency>
            <dependency>
                <groupId>com.hwc</groupId>
                <artifactId>hwc-device</artifactId>
            </dependency>
            <dependency>
                <groupId>com.hwc</groupId>
                <artifactId>hwc-knowledge</artifactId>
            </dependency>
            <dependency>
                <groupId>com.hwc</groupId>
                <artifactId>hwc-docgraph</artifactId>
            </dependency>
            <dependency>
                <groupId>com.hwc</groupId>
                <artifactId>hwc-device-data</artifactId>
            </dependency>
            <dependency>
                <groupId>com.hwc</groupId>
                <artifactId>hwc-agent</artifactId>
            </dependency>
            <dependency>
                <groupId>com.hwc</groupId>
                <artifactId>hwc-publish</artifactId>
            </dependency>
            <dependency>
                <groupId>com.hwc</groupId>
                <artifactId>hwc-workorder</artifactId>
            </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
