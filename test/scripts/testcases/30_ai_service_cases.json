      "id": "A-DIAG-02",
      "name": "常规-高危异常触发五步全流程（降级模式）",
      "category": "NORMAL",
      "method": "POST",
      "path": "/diagnosis/run",
      "json": {
        "deviceId": 1,
        "deviceName": "一号加工中心",
        "datasetId": 1,
        "phenomenon": "主轴温度持续升高",
        "anomalies": [
          {
            "metricId": 1,
            "metricName": "主轴温度",
            "anomalyType": "over_limit",
            "severity": "high",
            "startTime": "2026-10-18 10:00:00",
            "endTime": "2026-10-18 11:00:00",
            "peakValue": 95.5,
            "avgValue": 82.3,
            "summary": "主轴温度超过阈值"
          }
        ]
      },
      "expectHttp": 200,
      "expectCode": 0,
      "asserts": [
        {
          "path": "data.steps",
          "op": "sizeEq",
          "value": 5
        },
        {
          "path": "data.steps[0].agentCode",
          "op": "eq",
          "value": "monitor"
        },
        {
          "path": "data.steps[1].agentCode",
          "op": "eq",
          "value": "root_cause"
        },
        {
