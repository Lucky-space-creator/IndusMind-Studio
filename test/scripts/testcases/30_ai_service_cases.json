      "id": "A-HEALTH-01",
      "name": "常规-健康检查返回服务信息",
      "category": "NORMAL",
      "method": "GET",
      "path": "/health",
      "expectHttp": 200,
      "expectCode": 0,
      "asserts": [
        {
          "path": "data.service",
          "op": "eq",
          "value": "hwc-ai-service"
        },
        {
          "path": "data.version",
          "op": "exists"
        }
      ]
    },
