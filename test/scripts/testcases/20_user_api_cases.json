          "path": "data.current",
          "op": "eq",
          "value": 1
        }
      ]
    },
    {
      "id": "U-DASH-03",
      "name": "手动刷新看板快照（基于模拟数据集）",
      "category": "NORMAL",
      "method": "POST",
      "path": "/api/user/dashboard/refresh",
      "headers": {
        "Authorization": "Bearer ${engToken}"
      },
      "query": {
        "datasetId": "${datasetId}"
      },
      "expectHttp": 200,
      "expectCode": 0,
      "asserts": [
        {
          "path": "data.deviceId",
          "op": "eq",
          "value": 1
        },
        {
          "path": "data.healthScore",
          "op": "gte",
          "value": 0
        },
        {
          "path": "data.healthScore",
          "op": "lte",
          "value": 100
        },
        {
          "path": "data.status",
          "op": "exists"
        },
        {
          "path": "data.anomalyCount",
          "op": "gte",
          "value": 1
        },
        {
          "path": "data.snapshotTime",
          "op": "exists"
        }
      ]
