{
  "suite": "用户端接口测试（hwc-app-user :8180 测试端口）",
  "baseUrl": "http://127.0.0.1:8180",
  "cases": [
    {
      "id": "U-AUTH-01",
      "name": "eng1 正常登录用户端",
      "category": "NORMAL",
      "method": "POST",
      "path": "/api/user/auth/login",
      "json": {
        "username": "eng1",
        "password": "Demo@123"
      },
      "expectHttp": 200,
      "expectCode": 0,
      "asserts": [
        {
          "path": "data.token",
          "op": "exists"
        },
        {
          "path": "data.userId",
          "op": "exists"
        },
        {
          "path": "data.username",
          "op": "eq",
          "value": "eng1"
        },
        {
          "path": "data.end",
          "op": "eq",
          "value": "user"
        },
        {
          "path": "data.roles[0]",
          "op": "eq",
          "value": "ENGINEER"
        },
        {
          "path": "data.permissions",
          "op": "sizeGte",
          "value": 1
        }
      ],
      "extract": {
        "engToken": "data.token"
      }
    },
    {
      "id": "U-AUTH-02",
      "name": "review1 双端账号登录用户端",
      "category": "NORMAL",
      "method": "POST",
      "path": "/api/user/auth/login",
      "json": {
        "username": "review1",
        "password": "Demo@123"
      },
      "expectHttp": 200,
      "expectCode": 0,
      "asserts": [
        {
          "path": "data.token",
          "op": "exists"
        },
        {
          "path": "data.roles[0]",
          "op": "eq",
          "value": "REVIEWER"
        }
      ],
      "extract": {
        "revToken": "data.token"
      }
    },
    {
      "id": "U-AUTH-03",
      "name": "prod1 正常登录用户端",
      "category": "NORMAL",
      "method": "POST",
      "path": "/api/user/auth/login",
      "json": {
        "username": "prod1",
        "password": "Demo@123"
      },
      "expectHttp": 200,
      "expectCode": 0,
      "extract": {
        "prodToken": "data.token"
      }
    },
    {
      "id": "U-AUTH-04",
      "name": "错误密码登录被拒绝",
      "category": "EXCEPTION",
      "method": "POST",
      "path": "/api/user/auth/login",
      "json": {
        "username": "eng1",
        "password": "Wrong@123"
      },
      "expectHttp": 401,
      "expectCode": 401,
      "expectErrorCode": "COMMON_4001",
      "expectMessageContains": "用户名或密码错误"
    },
    {
      "id": "U-AUTH-05",
      "name": "不存在的用户登录被拒绝",
      "category": "EXCEPTION",
      "method": "POST",
      "path": "/api/user/auth/login",
      "json": {
        "username": "nobody",
        "password": "Demo@123"
      },
      "expectHttp": 401,
      "expectCode": 401,
      "expectErrorCode": "COMMON_4001"
    },
    {
      "id": "U-AUTH-06",
      "name": "用户名为空触发参数校验",
      "category": "BOUNDARY",
      "method": "POST",
      "path": "/api/user/auth/login",
      "json": {
        "username": "",
        "password": "Demo@123"
      },
      "expectHttp": 400,
      "expectCode": 400,
      "expectErrorCode": "COMMON_4100",
      "expectMessageContains": "用户名不能为空"
    },
    {
      "id": "U-AUTH-07",
      "name": "admin 账号登录用户端被拒（端隔离）",
      "category": "EXCEPTION",
      "method": "POST",
      "path": "/api/user/auth/login",
      "json": {
