        {
          "path": "data",
          "op": "exists"
        }
      ]
    },
    {
      "id": "U-DASH-02",
      "name": "设备 1 看板历史快照分页",
      "category": "NORMAL",
      "method": "GET",
      "path": "/api/user/dashboard/devices/1/history",
      "headers": {
        "Authorization": "Bearer ${engToken}"
